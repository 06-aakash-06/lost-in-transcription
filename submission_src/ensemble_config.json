{
  "device": "cuda",
  "compute_type": "float16",
  "cpu_threads": 8,
  "num_workers": 1,
  "calibration_file": "calibration.json",
  "decodes": [
    {
      "name": "whisper_base_id",
      "backend": "faster_whisper",
      "model": "models/whisper_large_v3",
      "language": "id",
      "beam_size": 5,
      "temperature": 0.0,
      "vad_filter": false,
      "condition_on_previous_text": false,
      "max_new_tokens": 256,
      "prior": 1.0,
      "enabled": true
    },
    {
      "name": "xlsr_mixed_id_jv_lm",
      "backend": "transformers_ctc",
      "model": "models/multilingual_xlsr_300m_5gram",
      "language": null,
      "use_language_model": true,
      "lm_alpha": 0.5,
      "lm_beta": 1.5,
      "prior": 1.0,
      "enabled": true
    },
    {
      "name": "qwen_id",
      "backend": "qwen_asr",
      "model": "models/qwen3_asr_1_7b",
      "language": "id",
      "max_new_tokens": 256,
      "prior": 1.0,
      "enabled": true
    }
  ],
  "adaptive_decodes": []
}
